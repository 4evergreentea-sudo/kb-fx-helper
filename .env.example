# Supabase 프로젝트 설정 (Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# 신규 프로젝트는 publishable key를 사용합니다.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# legacy 프로젝트에서 publishable key가 없고 anon key만 제공되는 경우에만 아래 값을 채우세요.
# VITE_SUPABASE_PUBLISHABLE_KEY가 설정되어 있으면 이 값은 사용되지 않습니다.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# service_role/secret key는 절대 여기(VITE_ 접두사 환경변수)에 넣지 마세요.
# VITE_ 접두사가 붙은 값은 빌드 시 브라우저 번들에 그대로 노출됩니다.
